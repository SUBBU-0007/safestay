# ==============================================================================
# SafeStay Crisis Coordination Engine & SMS Dispatcher Environment
# ==============================================================================

PORT=3001

# SMS Mode: "mock" (default for development/offline) or "real" (for live Twilio cellular alerts)
SMS_MODE=mock

# Twilio Credentials (Required when SMS_MODE=real)
# Format: Account SID starts with 'AC', Auth Token is 32-character hex, Phone Number in E.164
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_PHONE_NUMBER=+15005550006

# Public Application URL: Used in emergency SMS links sent to tourists
# For local development: http://localhost:5173
# For production: https://safestay.gov.in or https://your-domain.com
PUBLIC_APP_URL=http://localhost:5173

# Optional: Indian DLT Registration parameters for telecom compliance
# DLT_PRINCIPAL_ENTITY_ID=1101xxxxxxxxxxx
# DLT_TEMPLATE_ID=1107xxxxxxxxxxx
# DLT_HEADER_SENDER_ID=SFSTAY
